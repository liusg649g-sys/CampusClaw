# 双击启动CampusClaw.bat 会读取本地 .env；直接运行 server.py 时仍需设置环境变量。
# 留空时启动器尝试发现本机安装；如发现失败，请在 .env 填写完整路径。
CAMPUSCLAW_PYTHON=
CAMPUSCLAW_NGINX=
# 首次一键启动自动生成并保存在 .env，后续重复使用，不会显示在日志。
CAMPUSCLAW_TOKEN_SECRET=
# Only for first initialization. Empty creates a random local password;
# existing private account files are never overwritten.
CAMPUSCLAW_INITIAL_TEACHER_PASSWORD=
# 老师提供的 Base URL 应写到 /v1，程序会自行拼接具体接口路径。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=course-embedding
EMBEDDING_DIM=2048
CHAT_MODEL=course-chat
AI_GATEWAY_TIMEOUT_SECONDS=20
CHAT_BASE_URL=
CHAT_API_KEY=
AI_STREAM_TOTAL_SECONDS=120
# Optional additive SQLite database path (default backend/assistant.sqlite3).
CAMPUSCLAW_ASSISTANT_DB=

# 可选兼容项：仅在上面的新配置未设置时使用。
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=

# 独立 MCP 服务专用令牌（16~256位无空格ASCII字符）；仅该服务读取进程环境。
# 当前 CampusClaw 启动器不启动 MCP，也不会将此配置发送给前端。
# 请勿复用 CAMPUSCLAW_TOKEN_SECRET；此处不填写真实令牌。
MCP_AUTH_TOKEN=

# 主后端 MCP 出站地址精确白名单，逗号分隔；空值默认只允许 http://127.0.0.1:8090。
# localhost 统一为127.0.0.1；不接受任意域名、路径、重定向或环境代理。
# 此项由现有启动器读取；不要将服务器认证令牌填在URL中。
CAMPUSCLAW_MCP_ALLOWED_URLS=
# 单次回答工具决策轮次/累计调用上限；只允许下调，代码硬上限分别为4和8。
CAMPUSCLAW_MCP_MAX_ROUNDS=4
CAMPUSCLAW_MCP_MAX_CALLS=8
